{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::*"]
    },
    {
      "Sid": "ListarEAbrirObjetos",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::beesocial", "arn:aws:s3:::beesocial/*"]
    }
  ]
}
