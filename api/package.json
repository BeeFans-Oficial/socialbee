{
  "name": "@beesocial/api",
  "version": "1.0.0",
  "private": true,
  "description": "API do BeeSocial: identidade, perfil, links e rastreamento.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:run": "npm run db:ensure-schema && node -r ts-node/register/transpile-only ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node -r ts-node/register/transpile-only ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "db:ensure-schema": "node -r ts-node/register/transpile-only src/database/ensure-schema.ts",
    "db:ensure-schema:prod": "node dist/database/ensure-schema.js",
    "migration:run:prod": "npm run db:ensure-schema:prod && node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "seed": "node -r ts-node/register/transpile-only src/database/seeds/seed.ts",
    "seed:prod": "node dist/database/seeds/seed.js",
    "retention": "node -r ts-node/register/transpile-only src/database/seeds/retention.ts",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
